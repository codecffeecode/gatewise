{
  "name": "gatewise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,api -c cyan,green \"npm:dev:next\" \"npm:dev:api\"",
    "dev:next": "next dev",
    "dev:api": "uv run uvicorn backend.main:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "api:lint": "uv run ruff check backend api",
    "api:test": "uv run pytest",
    "db:migrate": "uv run alembic upgrade head",
    "db:revision": "uv run alembic revision --autogenerate -m",
    "db:seed": "uv run python -m backend.db.seed",
    "db:reset": "uv run python -m backend.db.reset"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
